# 可选模板：已在 ~/.bashrc 设置环境变量时，无需创建 .env 文件。
# 高德开放平台 Web 服务 Key
AMAP_API_KEY=your_amap_web_service_key
# 单进程共享的高德请求速率上限；请根据控制台配额设置。多进程需要共享限流。
AMAP_MAX_QPS=10

# Unsplash Developers 应用 Access Key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Jev 通过 OpenRouter Decisions API 做搜索词评分与真实地点选择。
OPENROUTER_API_KEY=your_openrouter_api_key
JEV_MODEL_ID=typesafe/jev-1.13
# 如需自动跟随最新版，可改为 ~typesafe/jev-latest

# 生成模型用于 Jev 前的中译英，以及中文路线标题与介绍文案；可只设置 DEEPSEEK_API_KEY。
# 使用其他兼容服务时才需要配置 LLM_BASE_URL 和 LLM_MODEL_ID。
DEEPSEEK_API_KEY=your_deepseek_api_key
# LLM_API_KEY=your_llm_api_key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_ID=deepseek-chat

# 和风天气：控制台“设置”里的账号专属API Host，只填域名（不填路径）
QWEATHER_API_HOST=
# 两种认证选一种。JWT优先；JWT过期后需要更新。
QWEATHER_API_KEY=
# QWEATHER_JWT=

# PostgreSQL: 本机 Unix socket；Windows 或远程数据库请改为带用户名密码的 TCP URL
DATABASE_URL=postgresql:///travelos

# 认证：生成随机密钥后配置，例如 python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_CSRF_SECRET=
# 生产 HTTPS 使用 true；本机 HTTP 开发显式设为 false。
AUTH_COOKIE_SECURE=true
# 测试日志必须输出到隔离目录，避免混入真实请求日志。
# TRAVELOS_LOG_DIR=/tmp/travelos-tests
